# Absolute path to the directory holding the wildcard cert and its key —
# the same pair Ito's stack already mounts. Mounted read-only.
# Expected filenames inside it:
#   STAR_IT_KMITL_AC_TH_PACK.crt
#   STAR_IT_KMITL_AC_TH.key
SSL_DIR=/home/cruz/RubsarbWebBoardgame

# 0 skips cross-compiling the five CLI binaries at image build time. They are
# ~400 MB in total and the build must reach bun.sh to fetch each foreign
# runtime once; the cost of skipping is that the /cli download section is
# hidden and people join with the browser or a hand-copied binary instead.
BUILD_CLI=1

# A room dies this many minutes after the last person disconnects. Locking a
# phone counts as disconnecting, so raise it if that bites during a class.
ROOM_EMPTY_GRACE_MINUTES=5

# Backstop for a room whose socket leaked and which therefore looks forever
# occupied. Should never fire in normal use.
ROOM_TTL_DAYS=30
